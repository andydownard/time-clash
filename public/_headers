# The voice service origin below (https://voice.timeclash.rallytasks.com) is the PLANNED custom
# domain for the second Railway service. It must match VITE_VOICE_URL exactly (docs/VOICE_SERVICE.md).
# If the real address differs, change it here and in the build setting together.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob: https://voice.timeclash.rallytasks.com; font-src 'self'; connect-src 'self' https://voice.timeclash.rallytasks.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
