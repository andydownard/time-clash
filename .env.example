# No secrets are needed for the game itself. These are the Phase 4 relay settings (server/).
# Origins allowed to open a WebSocket, comma separated. Required when NODE_ENV=production.
ALLOWED_ORIGINS=https://timeclash.rallytasks.com
# Set to 1 behind Railway's proxy so rate limits read the client address from the proxy header.
TRUST_PROXY=0
# Local relay port. Railway sets PORT itself.
PORT=8787
