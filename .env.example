# No secrets are needed through Phase 3. Phase 4 will list relay settings here.

# --- Voice service (voice-server/, see docs/VOICE_SERVICE.md). None of these are secrets. ---
# Voice service (the second Railway service):
PORT=8080
# Folder holding the voice-*.sqlite files, opened read-only.
VOICE_DB_DIR=db
# The one site allowed to use the audio.
ALLOWED_ORIGIN=https://timeclash.rallytasks.com

# Game build (Vite reads this at build time). Leave empty to switch the clip voice OFF:
# the game then behaves exactly as before. Example: https://voice.timeclash.rallytasks.com
VITE_VOICE_URL=
