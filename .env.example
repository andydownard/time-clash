# No secrets are needed through Phase 3. Phase 4 will list relay settings here.

# --- App server (app-server/, `npm start`, see docs/APP_SERVER.md). None of these are secrets. ---
PORT=8080
# Folder with the built site. Must hold index.html and _headers. Default: dist
DIST_DIR=dist
# Folder holding the voice-*.sqlite files, opened read-only. Default: db
VOICE_DB_DIR=db

# --- Game build (Vite reads this at build time) ---
# VITE_VOICE=on asks the app server for spoken clips at /v1/clips/<id> (same origin).
# It is already on in .env.production and .env.e2e. Leave it unset for `npm run dev`,
# which has no /v1/clips route, so the game uses the browser voice as it always did.
VITE_VOICE=
