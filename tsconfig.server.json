{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "outDir": "dist-server",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["app-server/*.ts", "voice-server/*.ts"]
}
